# ==============================================================================
# PadosiPlate environment — copy to .env locally, or add each variable as a
# Replit Secret. With MOCK_MODE=true every external call is simulated, so only
# JWT_SECRET (and DATABASE_URL in production) matter on day one.
# ==============================================================================

# ---- Core -------------------------------------------------------------------

# Postgres connection string. REQUIRED in production (NODE_ENV=production).
# Replit: set automatically when you add the PostgreSQL tool.
# Local dev: leave unset to use the embedded PGlite database (zero setup).
DATABASE_URL=

# Session signing secret (>= 20 chars). Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional separate key for encrypting ID/address documents at rest.
# Falls back to a key derived from JWT_SECRET. Generate: openssl rand -hex 32
DOC_ENCRYPTION_KEY=

# Public origin of the site (used in emails, share links, OG tags).
# Example: https://padosiplate.yourname.repl.co
SITE_URL=

# true (default) = payments, email, delivery and FSSAI verification are
# simulated in-app. false = live adapters; the keys below become required.
MOCK_MODE=true

# Protects the cron endpoint (/api/cron/run). Any long random string.
CRON_SECRET=

# ---- Admin access -------------------------------------------------------------

# Comma-separated, case-insensitive. A user whose VERIFIED email is in this list
# is an admin; nobody else can become admin. `npm run db:bootstrap` creates these
# accounts (random one-time password printed to the deploy log).
ADMIN_EMAILS="praveenece.mit@gmail.com,rsaralipriya.career@gmail.com"

# ---- Storage (uploads) --------------------------------------------------------

# local (dev default) | replit (production default) | s3
STORAGE_ADAPTER=local
# Replit Object Storage bucket id (Tools -> Object Storage). Replit usually
# provides DEFAULT_OBJECT_STORAGE_BUCKET_ID automatically.
REPLIT_OBJECT_STORAGE_BUCKET=
# --- only for STORAGE_ADAPTER=s3 (S3-compatible: AWS, R2, MinIO) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Email --------------------------------------------------------------------

# mock (default): writes to the admin-viewable outbox (/admin/outbox).
# resend: sends via Resend; needs RESEND_API_KEY.
EMAIL_ADAPTER=mock
RESEND_API_KEY=
EMAIL_FROM="PadosiPlate <no-reply@padosiplate.example>"

# ---- Razorpay (required when MOCK_MODE=false) ---------------------------------
# Razorpay collects ONLY the platform's own fees (kitchen subscriptions and the
# buyer platform fee). Food money goes buyer -> kitchen directly (UPI / pickup).
# Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> URL https://<site>/api/webhooks/razorpay
# Events: payment.captured, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional adapters (each falls back to a mock without a key) ---------------

# Geocoding for /admin/societies "Geocode" button (mock-safe)
GEOCODE_API_KEY=

# Delivery partners (feature-flagged overflow; off for the pilot)
PORTER_API_KEY=
PORTER_BASE_URL=
SHADOWFAX_API_TOKEN=
SHADOWFAX_BASE_URL=
BORZO_AUTH_TOKEN=
BORZO_BASE_URL=

# Live FSSAI licence lookup (dormant while MOCK_MODE=true)
FSSAI_VERIFY_API_KEY=

# ---- Demo data (never in production) --------------------------------------------

# The embedded dev DB seeds demo accounts (password demo1234). Seeding refuses to
# run when NODE_ENV=production unless this is "true".
ALLOW_DEMO_SEED=
