# ============================================================
# GharSe environment — copy to .env (locally) or add each var
# as a Replit Secret. Every external call is mocked until you
# flip MOCK_MODE=false, so only DATABASE_URL and JWT_SECRET
# matter on day one.
# ============================================================

# --- Core ---

# PostgreSQL connection string.
# Replit: created automatically when you add the PostgreSQL tool (uses Neon).
# Local dev: LEAVE UNSET to use the embedded PGlite database (zero setup).
DATABASE_URL=

# Sign-in cookie signing secret. Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# true (default) = every integration (payments, delivery, FSSAI verify) is a
# realistic in-app mock; the whole product is clickable with no keys.
# false = real adapters are used and the keys below become required.
MOCK_MODE=true

# --- Razorpay (required when MOCK_MODE=false) ---
# Test-mode keys from https://dashboard.razorpay.com → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in Dashboard → Webhooks for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- Delivery providers (each optional; adapters fall back to mock without a key) ---
# Porter for Enterprise — from Porter partner onboarding
PORTER_API_KEY=
PORTER_BASE_URL=
# Shadowfax Flash — token from your Shadowfax SPOC
SHADOWFAX_API_TOKEN=
SHADOWFAX_BASE_URL=
# Borzo business API — https://borzodelivery.com/in/business-api
BORZO_AUTH_TOKEN=
BORZO_BASE_URL=

# --- FSSAI license verification (Surepass-style provider) ---
FSSAI_VERIFY_API_KEY=

# --- Runtime ---
# Replit sets PORT automatically; Next.js honours it for dev and start.
# PORT=3000
