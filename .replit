run = "npm run dev"
entrypoint = "src/app/page.tsx"
modules = ["nodejs-20", "postgresql-16"]
hidden = [".next", "node_modules", ".data"]

[nix]
channel = "stable-24_05"

# Autoscale: build once (install, migrate + bootstrap the DB, compile), then
# serve with `next start`. The DB and Object Storage are shared across instances.
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run db:bootstrap && npm run build"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80
